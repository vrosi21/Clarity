POSTGRES_DB=clarity
POSTGRES_USER=clarity_user
POSTGRES_PASSWORD=clarity_password
DATABASE_URL=postgresql://clarity_user:clarity_password@db:5432/clarity
SECRET_KEY=change_me

# LangChain + Groq (LLM reasoning layer — tags, category reasoning, story point explanations).
# Get a free API key at https://console.groq.com
# Recommended model: llama-3.1-8b-instant (fast, free, smart enough for ticket suggestions)
# Other good options: llama-3.3-70b-versatile (smarter, slower), gemma2-9b-it
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
